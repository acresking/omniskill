{
  "name": "omniskill",
  "version": "1.3.0",
  "description": "The Universal Cross-Platform AI Skill Engine — Transpile skills between Claude Code, Google Gemini, ChatGPT, xAI Grok, Perplexity, DeepSeek, Qwen, Ollama, LM Studio, and Cursor with security hardening.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "omniskill": "./bin/omniskill.js"
  },
  "files": [
    "bin",
    "src",
    "sdk",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/omniskill.js serve",
    "bundle": "node bin/omniskill.js bundle",
    "inspect": "node bin/omniskill.js inspect",
    "mcp": "node bin/omniskill.js mcp",
    "install-agent": "node bin/omniskill.js install-agent"
  },
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "gemini",
    "antigravity",
    "openai",
    "chatgpt",
    "gpts",
    "custom-gpts",
    "grok",
    "xai",
    "perplexity",
    "deepseek",
    "qwen",
    "kimi",
    "ollama",
    "lmstudio",
    "muse",
    "openwebui",
    "cursor",
    "skills",
    "agent-skills",
    "universal-converter",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "author": "acresking <https://github.com/acresking>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acresking/omniskill.git"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
